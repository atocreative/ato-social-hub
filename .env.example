# ====================================================
# ATO SOCIAL HUB — CONFIGURAÇÃO DE AMBIENTE (ETAPA 8)
# Nunca versione segredos reais neste arquivo.
# Configure os valores reais em Secrets / Variáveis de Ambiente do Google Cloud Run ou Railway.
# ====================================================

# 1. Banco de Dados PostgreSQL (Railway — Fonte Única de Verdade)
DATABASE_URL=postgresql://postgres:<PASSWORD>@<HOST>:<PORT>/railway
PGSSLMODE=require
DB_POOL_MAX=10

# 2. Google Gemini API (Geração de Legendas Server-Side)
GEMINI_API_KEY=<GEMINI_API_KEY>
GEMINI_MODEL=gemini-3.1-flash-lite

# 3. Instagram Official OAuth & Graph API (v21.0)
# Importante: Não é necessário salvar access_token manualmente no .env.
# Os tokens das contas conectadas são obtidos via OAuth, convertidos em longa duração (60 dias),
# criptografados com AES-256-GCM e persistidos na tabela instagram_accounts do PostgreSQL.
INSTAGRAM_APP_ID=1638364467693255
INSTAGRAM_APP_SECRET=<INSTAGRAM_APP_SECRET>
INSTAGRAM_REDIRECT_URI=https://ato-social-hub.ai.studio/api/auth/instagram/callback
META_VERIFY_TOKEN=ato_meta_webhook_2026

# 4. Segurança, Sessão e Criptografia de Tokens
JWT_SECRET=<JWT_SECRET>
# Aceita chave Hexadecimal de 64 caracteres, Base64 de 32 bytes ou passphrase (derivada via SHA-256 para AES-256-GCM)
TOKEN_ENCRYPTION_KEY=<CHAVE_DE_CRIPTOGRAFIA_32_BYTES>
WEBHOOK_SECRET_TOKEN=<WEBHOOK_SECRET_TOKEN>
CRON_SECRET=<CRON_SECRET>

# 5. Processamento de Agendamentos Independente de Hospedagem (Etapa 5)
# Modos suportados:
#   - http     : Cloud Run (padrão) — acionado externamente via POST /api/scheduler/run com CRON_SECRET
#   - worker   : Railway Worker contínuo — executa loop a cada WORKER_INTERVAL_MS
#   - disabled : Web service puro no Railway (quando há serviço Worker separado rodando npm run worker:start)
SCHEDULER_MODE=http
WORKER_INTERVAL_MS=20000

# 6. Google Drive / Google Apps Script Integration
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbwq9EAn9TbPzq87O6yVT61KY2qd-w0wpX09hMqviu-4Gu3Lskzvb73RPvTr98FK0Z1rFQ/exec
GAS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbwq9EAn9TbPzq87O6yVT61KY2qd-w0wpX09hMqviu-4Gu3Lskzvb73RPvTr98FK0Z1rFQ/exec

# 7. Aplicação Web
NODE_ENV=production
PORT=3000
APP_BASE_URL=
APP_URL=
